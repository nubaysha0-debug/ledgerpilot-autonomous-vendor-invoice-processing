# Copy this file to .env for local development. .env is ignored by Git.
# Never commit real bank credentials, API keys, customer data or vendor secrets.
# The demo works without any paid or external service.

# ---------------------------------------------------------------------------
# Frontend (Vite). The console auto-detects a running API, then falls back to
# browser-local mode. Use ?api=off to force the local demo.
# ---------------------------------------------------------------------------
# VITE_API_URL="http://127.0.0.1:8000"

# ---------------------------------------------------------------------------
# Backend / PostgreSQL. Docker Compose supplies its own DATABASE_URL.
# For the embedded PostgreSQL path, use the URL printed by
# `python -m backend.scripts.dev_postgres` (also written to backend/.pg_url).
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres@127.0.0.1:55432/ledgerpilot"
# API_PORT=8000
# APP_ENV=local
# DEMO_MODE=true
# EXTRACTOR=mock
# LLM_PROVIDER=mock
# CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
# MAX_UPLOAD_MB=10
# MAX_PDF_PAGES=5
# UPLOAD_DIR=backend/data/uploads
# MOCK_ALLOW_FORCED_FAILURE=true
# MAX_EXECUTE_ATTEMPTS=3

# Optional. The demo is rules-first and does not need a model key.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL=""
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Acceptance tests. Optional external disposable database; the name must end
# in _test. Leave unset to let the harness start embedded PostgreSQL.
# ---------------------------------------------------------------------------
# LP_TEST_DATABASE_URL="postgresql://ledger:ledger_demo_only@127.0.0.1:5432/ledgerpilot_test"
# OLD_GEMINI_API_KEY=""  # optional: prove an old Google key is revoked
