rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile: only the user themselves can read and write their profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Invoices subcollection: owned by the user
      match /invoices/{invoiceId} {
        allow read, write: if isOwner(userId) && isValidId(invoiceId);
      }

      // Chat messages subcollection: owned by the user
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) && isValidId(messageId);
      }
    }

    // Test connection document for bootstrap validation
    match /test/{docId} {
      allow read: if isSignedIn();
    }
  }
}
